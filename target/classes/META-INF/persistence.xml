<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">
    <persistence-unit name="HibernateJPAProjectPU" transaction-type="RESOURCE_LOCAL">
        <class>com.mycompany.hibernatejpaproject.Artista</class>
        <class>com.mycompany.hibernatejpaproject.Discografia</class>
        
        <properties>
            <property name="jakarta.persistence.jdbc.url" value="jdbc:mysql://127.0.0.1:3307/hibernate_project"/> <!-- Dades de conexió a la base de dades -->
            <property name="jakarta.persistence.jdbc.user" value="root"/>    <!-- Usuari per accedir a la bd -->
            <property name="jakarta.persistence.jdbc.password" value=""/>  <!-- Contrasenya de l'usuari per accedir a la bd (no ne tinc) -->
            <property name="jakarta.persistence.jdbc.driver" value="com.mysql.cj.jdbc.Driver"/> <!-- Driver JDBC per connectar amb MySQL -->

            <!-- Configuración de Hibernate -->
            <property name="hibernate.hbm2ddl.auto" value="update"/> <!-- Actualitza automàticament l'esquema de la base de dades -->
            <property name="hibernate.show_sql" value="true"/>  <!-- Mostra les consultes SQL generades per Hibernate -->
        </properties>
    </persistence-unit>
</persistence>
